{
  "name": "@sandsoftwaresolutions/env-guard",
  "version": "0.1.1",
  "description": "Check environment variables at startup: typed, all problems at once, secrets never shown. Writes your .env.example too.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "env",
    "environment",
    "dotenv",
    "config",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-env-guard.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-env-guard/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-env-guard#readme",
  "publishConfig": {
    "access": "public"
  }
}
